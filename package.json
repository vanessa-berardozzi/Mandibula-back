{
  "name": "mandibula-back",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "cross-env NODE_ENV=production node ./dist/index.js",
    "dev": "cross-env NODE_ENV=development NODE_OPTIONS=--max-http-header-size=131072 nodemon --watch src --exec ts-node src/index.ts",
    "staging": "cross-env NODE_ENV=staging node --require ./dist/env.js ./dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:staging": "dotenv -e .env.staging -- prisma migrate deploy",
    "prisma:migrate:prod": "dotenv -e .env.production -- prisma migrate deploy",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:db:push": "prisma db push",
    "prisma:db:push:staging": "dotenv -e .env.staging -- prisma db push",
    "prisma:db:seed": "prisma db seed",
    "prisma:db:seed:staging": "dotenv -e .env.staging -- prisma db seed",
    "prisma:studio": "prisma studio",
    "prisma:studio:staging": "dotenv -e .env.staging -- prisma studio",
    "prisma:studio:prod": "dotenv -e .env.production -- prisma studio",
    "test": "vitest run",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "better-auth": "^1.4.10",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "http-errors": "~1.6.3",
    "multer": "^2.2.0",
    "resend": "^6.6.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitest/ui": "^4.0.16",
    "c8": "^10.1.3",
    "cross-env": "^10.1.0",
    "csv-parse": "^6.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "nodemon": "^3.1.11",
    "prettier": "^3.2.5",
    "prisma": "^7.2.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.16"
  },
  "prisma": {
    "seed": "tsx prisma/seed/seed.ts"
  }
}
