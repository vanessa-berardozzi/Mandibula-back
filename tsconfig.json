{
	"compilerOptions": {
		"target": "es2023",
		"module": "commonjs",
		"lib": ["ES2023"],
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
	},
	"include": ["src/**/*", "src/lib/auth.ts"],
	"exclude": ["node_modules", "dist"]
}
