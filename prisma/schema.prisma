// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING       // Nouvelle, pas encore payée
  CONFIRMED     // Payée, à traiter
  PREPARING     // En cours de préparation
  HELD_WEATHER  // Expédition du vivant suspendue pour raison météo
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  SUM_UP
  PAYPAL
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING   // En attente de paiement
  PAID      // Paiement confirmé par SumUp
  FAILED    // Paiement refusé
  REFUNDED  // Remboursé
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum StockMovementType {
  ENTRY               // arrivage fournisseur
  SALE                // vente confirmée (paiement validé)
  RESERVATION         // commande créée (PENDING) -> bloque le stock
  RESERVATION_RELEASE // commande annulée/expirée avant paiement -> libère
  LOSS                // mortalité, casse
  ADJUSTMENT          // correction manuelle après inventaire physique
  RETURN              // retour client (SAV)
}

enum PromotionType {
  NONE
  PERCENTAGE
  FIXED_AMOUNT
}

/// Catégorie fiscale d'un produit. À faire correspondre à vos vraies
/// catégories métier (un arthropode vivant et une boîte d'élevage n'ont
/// pas forcément le même taux selon le pays de destination).
enum ProductVatCategory {
  STANDARD_GOODS // matériel d'élevage, accessoires, terrariums...
  LIVE_ANIMALS   // arthropodes vivants
}

enum VatRateType {
  STANDARD
  REDUCED
  SUPER_REDUCED
  ZERO
}

// MODELS
// User and auth

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  Boolean   @default(false)
  name           String    
  image          String? 
  pictureProfile String?
  lastConnection DateTime  @default(now())
  role           Role      @default(USER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions  Session[]
  orders    Order[]
  adresses  Adress[]
  accounts  Account[]
  cart      Cart?
  wishlist  Wishlist[]

  @@map("user")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@map("session")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model rateLimit {
  id          String @id @default(uuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model Adress {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  name       String?
  fullName   String?
  street     String
  city       String
  postalCode String
  country    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Catalog and stock

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?
  image       String?
  isActive    Boolean @default(true)

  // Hiérarchie : null = catégorie racine, sinon = sous-catégorie
  parentId String?
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children Category[] @relation("SubCategories")

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  images      String[]

  attributes Json?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  totalStock    Int @default(0) // Stock total de l'espèce (individus physiquement présents)
  reservedStock Int @default(0) // Bloqué par des commandes PENDING non encore payées
  // Stock vendable = totalStock - reservedStock (calculé côté service, jamais stocké)

  shippingWeight Decimal? @db.Decimal(10, 2) // En grammes, sert au calcul des frais de port
  isPublished    Boolean  @default(true) // Visible dans le catalogue public

  vatCategory ProductVatCategory @default(STANDARD_GOODS)

  // Promotions
  promotionType  PromotionType @default(NONE)
  promotionValue Decimal?      @db.Decimal(10, 2) // Montant de la réduction (% ou €)
  featured       Boolean       @default(false) // Afficher dans "sélection du moment"

  variants  ProductVariant[]
  stockInfo StockInfo?
  wishlist  Wishlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name    String  // "Lot de 5"
  lotSize Int     @default(1) // Combien d'unités dans le lot
  price   Decimal @db.Decimal(10, 2)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  StockMovement[]

  @@unique([productId, name])
  @@map("product_variant")
}

model StockInfo {
  id        String  @id @default(uuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // quantity est calculé à la volée : SUM(productVariant.stock) WHERE productId
  minThreshold Int         @default(5) // Seuil pour LOW_STOCK
  status       StockStatus @default(IN_STOCK)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockMovement {
  id        String         @id @default(uuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productId String         // Dénormalisé pour requêtes dashboard sans jointure

  type     StockMovementType
  quantity Int     // TOUJOURS en individus (déjà résolu : lotSize * nb de lots), jamais en nombre de lots
  reason   String? // libre, pour ADJUSTMENT/LOSS uniquement (contexte humain)

  // Traçabilité fiable : FK plutôt que texte libre dans `reason`
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  // Pour une ENTRY : sert à valoriser le stock (CUMP), utile pour la compta
  unitCost Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([productId, type]) // ← CRITIQUE: pour calcul rapide stock disponible
  @@index([orderId])
  @@index([createdAt]) // ← Pour logs/audit
}

// Orders

model Order {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod

  // Référence de transaction retournée par SumUp après paiement
  sumupCheckoutId String? @unique

  subtotal     Decimal  @db.Decimal(10, 2) // Total produits HT
  shippingCost Decimal  @default(0) @db.Decimal(10, 2)
  tax          Decimal? @db.Decimal(10, 2)
  total        Decimal  @db.Decimal(10, 2) // subtotal + shippingCost + tax

  billingAddress  String?
  shippingAddress String?

  // Instructions spéciales (ex: "expédition vivant", "retrait sur place")
  notes String?

  // Si le paiement n'est pas confirmé avant cette date, un job libère
  // le stock réservé (StockMovement RESERVATION_RELEASE) et peut annuler la commande.
  reservationExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems     OrderItem[]
  stockMovements StockMovement[]
  invoice        Invoice?

  @@index([userId, paymentStatus]) // ← Pour lister les commandes actives d'un user
  @@index([paymentStatus, createdAt]) // ← Pour dashboard/analytics
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity    Int
  price       Decimal @db.Decimal(10, 2) // Prix snapshot au moment de la commande
  variantName String  // Snapshot : "Lot de 10" (au cas où la variante est modifiée)

  createdAt DateTime @default(now())
}

// Shopping Cart

model Cart {
  id         String  @id @default(cuid())
  userId     String? @unique
  guestToken String? @unique
  user       User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([guestToken])
  @@map("cart")
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity Int     @default(1)
  price    Decimal @db.Decimal(10, 2) // Prix snapshot au moment de l'ajout

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_item")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist")
}

// Invoicing
// Numérotation séquentielle SANS TROU distincte du n° de commande (exigence légale LU/UE)

model Invoice {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  invoiceNumber String   @unique // ex: généré via une séquence Postgres dédiée
  issuedAt      DateTime @default(now())

  totalHT  Decimal @db.Decimal(10, 2)
  totalVAT Decimal @db.Decimal(10, 2)
  totalTTC Decimal @db.Decimal(10, 2)
  vatRate  Decimal @db.Decimal(5, 2)

  pdfUrl String?

  @@map("invoice")
}

// VAT / Tax

model Country {
  /// Code ISO 3166-1 alpha-2 (FR, BE, DE, LU...)
  code       String    @id @db.Char(2)
  name       String
  isEuMember Boolean   @default(true)
  vatRates   VatRate[]

  @@map("countries")
}

/// Table de référence des taux de TVA par pays et par catégorie de produit.
/// Historisée via validFrom/validTo pour pouvoir modifier un taux à une
/// date donnée sans perdre l'historique (utile en cas de contrôle).
model VatRate {
  id              String             @id @default(cuid())
  countryCode     String
  country         Country            @relation(fields: [countryCode], references: [code])
  productCategory ProductVatCategory
  rateType        VatRateType
  /// Taux en pourcentage, ex: 20.00 pour 20%
  rate            Decimal            @db.Decimal(5, 2)
  validFrom       DateTime           @default(now())
  validTo         DateTime?
  /// Référence/source de la donnée (utile pour audit — ex: "impots.gouv.fr, MAJ 2026-01")
  source          String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([countryCode, productCategory, validFrom])
  @@index([countryCode, productCategory])
  @@map("vat_rates")
}

/// Cache des vérifications de numéro de TVA intracommunautaire (VIES).
/// Sert de preuve en cas de contrôle (obligation de justifier le B2B)
/// et évite de spammer l'API européenne à chaque commande.
model VatNumberCheck {
  id             String   @id @default(cuid())
  vatNumber      String   @unique
  countryCode    String
  isValid        Boolean
  companyName    String?
  /// Identifiant de consultation renvoyé par VIES (preuve officielle)
  consultationId String?
  checkedAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([vatNumber])
  @@map("vat_number_checks")
}
